# Local data, weights and artifacts. Anchor these so a future source directory
# named `models/` or `voices/` is not swallowed by accident.
/models/
/voices/
/input/
/output*/
/third_party/
/.venv*/
/.stretch_tmp/

# Local staging for raw demo media; curated files live in docs/media/.
/assets/

# Saved voice prints: reference audio and transcripts are personal data.

# Local configuration: may contain API keys
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Logs and OS/tooling cruft
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
.ipynb_checkpoints/

# Model weights outside models/
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.gguf

# Media (audio/video)
*.wav
*.mp3
*.flac
*.m4a
*.mp4
*.mkv
*.mov
*.webm
*.out

# …but allow small, consented demo assets.
!docs/media/**
!examples/media/**
