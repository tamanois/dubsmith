# Copy to `.env` and adjust. Real environment variables always win over this file.
#   cp .env.example .env
#
# The translation stage talks to any OpenAI-compatible /v1/chat/completions
# endpoint. The default targets a local llama.cpp `llama-server`; swapping to a
# cloud provider is a two-line change (base URL + model + key).

# --- Translation and planning (LLM) -----------------------------------------
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model
LLM_TIMEOUT_S=180
# Lines per request. Lower this if the model returns malformed JSON.
LLM_CHUNK_SIZE=40
# Lines per planning request for --style-plan llm / --prosody-plan llm before
# they switch to the whole-passage overview + chunked strategy. Keep it small.
LLM_PLAN_CHUNK_SIZE=10

# --- Loudness ----------------------------------------------------------------
# match-source (default): sit the dub at the level of the original track.
# lufs: force the absolute target below (EBU R128 style).
LOUDNESS_TARGET=match-source
LOUDNESS_LUFS=-16

# --- Background --------------------------------------------------------------
KEEP_BACKGROUND=1
BACKGROUND_SEPARATOR=auto
DUCK_DB=6.0

# --- Paths -------------------------------------------------------------------
# Where `python dub.py models --download` stores weights.
MODELS_DIR=models
# Saved voice library (clip + manifest + cards + provenance).
VOICES_DIR=voices

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# 1 = one JSON object per line (for log collectors).
LOG_JSON=0
# Also write the log here; the CLI default is the job folder.
#LOG_FILE=

# --- Optional backends -------------------------------------------------------
# Chatterbox and Fish run in their own environments. Leave these unset to use
# .venv-chatterbox and .venv-fish in the repository.
#CHATTERBOX_PYTHON=.venv-chatterbox/bin/python
#FISH_PYTHON=.venv-fish/bin/python
#COSYVOICE_PYTHONPATH=
#FISH_MAX_SEQ_LEN=4096

# --- Hugging Face ------------------------------------------------------------
# Needed only for gated checkpoints, or set HF_HUB_OFFLINE=1 for an offline run.
#HF_TOKEN=
#HF_HUB_OFFLINE=
