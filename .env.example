# Copy to `.env` and adjust. Real environment variables always win over this file.
#   cp .env.example .env
#
# The translation stage talks to any OpenAI-compatible /v1/chat/completions
# endpoint. The default targets a local llama.cpp `llama-server`; swapping to a
# cloud provider is a two-line change (base URL + model + key).

# --- Translation (LLM) -------------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model
LLM_TIMEOUT_S=180
# Lines per request. Lower this if the model returns malformed JSON.
LLM_CHUNK_SIZE=40

# --- Paths -------------------------------------------------------------------
# Where `python dub.py models --download` stores weights.
MODELS_DIR=models

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# 1 = one JSON object per line (for log collectors).
LOG_JSON=0
